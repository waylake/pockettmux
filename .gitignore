# --- macOS ---
.DS_Store
*.swp

# --- Xcode / SwiftPM (generated) ---
# App/PocketTmux.xcodeproj is regenerated by `xcodegen generate` (App/Project.yml is the source of truth)
App/*.xcodeproj
# xcodebuild -derivedDataPath build/<Name> (Sim, Device, Mac, Daemon, test…)
build/
App/build/
DerivedData/
# swift build / swift test output of the shared package
App/PocketTmuxKit/.build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserdatad
.swiftpm/
# keep Package.resolved tracked (dependency pins)

# --- release packaging ---
App/ExportOptions.plist
*.xcarchive

# --- fastlane (P3) ---
fastlane/report.xml
fastlane/screenshots/

# --- logs ---
*.log
